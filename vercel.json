{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    { "src": "/config.js", "headers": { "Cache-Control": "no-store" }, "continue": true },
    { "src": "/index\\.html", "status": 308, "headers": { "Location": "/" } },
    { "src": "/(manage|404)\\.html", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "/crm/index\\.html", "status": 308, "headers": { "Location": "/crm" } },
    { "src": "/vendor/supabase\\.js", "dest": "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.118.0/dist/umd/supabase.js" },
    { "src": "/crm/?", "dest": "/crm/index.html" },
    { "src": "/manage/?", "dest": "/manage.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
